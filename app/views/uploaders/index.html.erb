<head>
    <%= stylesheet_link_tag 'uploaders', media: 'all', data: { turbolinks: false } %>
</head>

<h1>Uploader</h1>

    <%= form_tag uploaders_path, multipart: true, class: "uploaders__main" do %>
        <%= file_field_tag :file, class: "uploaders__button" %>
        <%= submit_tag "Import", class: "uploaders__button" %>
    <% end %>


